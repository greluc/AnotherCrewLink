<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Third-party licences — AnotherCrewLink</title>
<style>
body { font-family: system-ui, sans-serif; margin: 3rem auto; max-width: 52rem; line-height: 1.6; }
h2 { margin-top: 2.5rem; border-bottom: 1px solid #ccc; padding-bottom: .25rem; }
pre { background: #f6f6f6; padding: 1rem; overflow-x: auto; white-space: pre-wrap; font-size: .85rem; }
ul { columns: 2; }
</style>
</head>
<body>
<h1>Third-party licences</h1>
<p>
AnotherCrewLink is distributed under the GPL-3.0-or-later. It links the crates below, and
this file reproduces their licence texts as those licences require. It is generated by
<code>cargo about generate about.hbs -o THIRD-PARTY.html</code>; do not edit it by hand.
</p>
{{#each licenses}}
<h2>{{name}}</h2>
<p>Used by:</p>
<ul>
{{#each used_by}}
<li>{{crate.name}} {{crate.version}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
