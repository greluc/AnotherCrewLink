{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/game/**",
              "components/navigation/**",
              "mockups/**",
              "ui_kits/client/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Varela Round|Source Code Pro|Material Symbols Rounded))/i]",
        "message": "Font not provided by the design system. Available: Varela Round, Source Code Pro, Material Symbols Rounded."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:severity|children|style|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: severity, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='severity'] > Literal[value!=/^(?:error|info|success|warning)$/]",
        "message": "<Alert> severity must be one of 'error' | 'info' | 'success' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|color|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, color, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:text|contained)$/]",
        "message": "<Button> variant must be one of 'text' | 'contained'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:primary|secondary|grey)$/]",
        "message": "<Button> color must be one of 'primary' | 'secondary' | 'grey'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|disabled|onChange|divided|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, disabled, onChange, divided."
      },
      {
        "selector": "JSXOpeningElement[name.name='Crewmate'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|shadow|size|talking|alive|lookLeft|link|hat|hatBack|visor|skin|showBorder|shape|overflow|usingRadio|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<Crewmate> doesn't accept that prop. Declared props: color, shadow, size, talking, alive, lookLeft, link, hat, hatBack, visor, skin, showBorder, shape, overflow, usingRadio, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Crewmate'] > JSXAttribute[name.name='link'] > Literal[value!=/^(?:connected|novoice|disconnected)$/]",
        "message": "<Crewmate> link must be one of 'connected' | 'novoice' | 'disconnected'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Crewmate'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:circle|sprite)$/]",
        "message": "<Crewmate> shape must be one of 'circle' | 'sprite'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|actions|width|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, children, actions, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:spacing|style|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: spacing, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|size|color|onClick|label|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, size, color, onClick, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:small|medium)$/]",
        "message": "<IconButton> size must be one of 'small' | 'medium'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LaunchButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|platforms|disabled|onLaunch|onSelect|key|ref|className|style|children)$/]",
        "message": "<LaunchButton> doesn't accept that prop. Declared props: label, platforms, disabled, onLaunch, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='LobbyCode'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|background|hidden|key|ref|className|style|children)$/]",
        "message": "<LobbyCode> doesn't accept that prop. Declared props: code, background, hidden."
      },
      {
        "selector": "JSXOpeningElement[name.name='LobbyTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|renderAction|key|ref|className|style|children)$/]",
        "message": "<LobbyTable> doesn't accept that prop. Declared props: columns, rows, renderAction."
      },
      {
        "selector": "JSXOpeningElement[name.name='MeterBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|indeterminate|color|width|height|key|ref|className|style|children)$/]",
        "message": "<MeterBar> doesn't accept that prop. Declared props: value, indeterminate, color, width, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='MeterBar'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:primary|secondary)$/]",
        "message": "<MeterBar> color must be one of 'primary' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OutlineButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onClick|size|disabled|style|key|ref|className|style|children)$/]",
        "message": "<OutlineButton> doesn't accept that prop. Declared props: children, onClick, size, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OverlayCapsule'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|position|compact|style|key|ref|className|style|children)$/]",
        "message": "<OverlayCapsule> doesn't accept that prop. Declared props: children, position, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OverlayCapsule'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:top|bottom_left|left|right|menu)$/]",
        "message": "<OverlayCapsule> position must be one of 'top' | 'bottom_left' | 'left' | 'right' | 'menu'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlayerSlot'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|color|shadow|size|slot|talking|alive|badge|own|hat|hatBack|visor|skin|link|usingRadio|shape|overflow|assetBase|onClick|key|ref|className|style|children)$/]",
        "message": "<PlayerSlot> doesn't accept that prop. Declared props: name, color, shadow, size, slot, talking, alive, badge, own, hat, hatBack, visor, skin, link, usingRadio, shape, overflow, assetBase, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlayerSlot'] > JSXAttribute[name.name='badge'] > Literal[value!=/^(?:muted|deafened|novoice|disconnected|bugged)$/]",
        "message": "<PlayerSlot> badge must be one of 'muted' | 'deafened' | 'novoice' | 'disconnected' | 'bugged'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlayerSlot'] > JSXAttribute[name.name='link'] > Literal[value!=/^(?:connected|novoice|disconnected)$/]",
        "message": "<PlayerSlot> link must be one of 'connected' | 'novoice' | 'disconnected'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlayerSlot'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:circle|sprite)$/]",
        "message": "<PlayerSlot> shape must be one of 'circle' | 'sprite'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|selected|onSelect|key|ref|className|style|children)$/]",
        "message": "<RadioOption> doesn't accept that prop. Declared props: label, value, selected, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|align|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: children, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeading> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|options|onChange|fullWidth|key|ref|className|style|children)$/]",
        "message": "<SelectField> doesn't accept that prop. Declared props: label, value, options, onChange, fullWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|min|max|step|disabled|color|suffix|onChange|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: label, value, min, max, step, disabled, color, suffix, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:primary|secondary)$/]",
        "message": "<Slider> color must be one of 'primary' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|size|style|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: state, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:muted|deafened|novoice|disconnected|bugged)$/]",
        "message": "<StatusBadge> state must be one of 'muted' | 'deafened' | 'novoice' | 'disconnected' | 'bugged'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|placeholder|error|helperText|readOnly|onChange|onKeyDown|fullWidth|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, value, placeholder, error, helperText, readOnly, onChange, onKeyDown, fullWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='TitleBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:version|onSettings|onReload|onClose|title|key|ref|className|style|children)$/]",
        "message": "<TitleBar> doesn't accept that prop. Declared props: version, onSettings, onReload, onClose, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|placement|open|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: title, children, placement, open."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute[name.name='placement'] > Literal[value!=/^(?:top|bottom)$/]",
        "message": "<Tooltip> placement must be one of 'top' | 'bottom'."
      }
    ]
  },
