+# Added by AnotherCrewLink: the TURN stream splitter, so that a relay allocation can be
+# made over TCP. A workspace member of that project rather than a module here, so the one
+# place that parses bytes off a hostile network stays inside every gate its CI runs.
+# The version has to be spelled out: `deny.toml` sets `allow-wildcard-paths = false`, so an
+# unversioned path dependency fails the bans check -- which is the setting working, not the
+# setting getting in the way. It must match `workspace.package.version` in the manifest two
+# directories up, and a version bump therefore touches this line and the patch file with it.
+[dependencies.acl-turn-framing]
+path = "../../crates/acl-turn-framing"
+version = "=2.0.0-alpha.5"
+
