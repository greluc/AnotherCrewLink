.DS_Store
# Anchored: the packaged output lives at the repository root. Without the slash
# this also swallowed the prebuilt dist/ of the vendored modules under native/.
/dist/
/out/

# And every scratch variant of them. `dist-diag/`, `dist-verify2/` and three more
# siblings were committed by a `git add -A` on 2026-08-23 because the anchored rules
# above match `dist/` exactly and nothing beside it — 48.5 MB of packed app.asar in a
# repository that holds no build output on purpose.
/dist-*/
/out-*/
node_modules/
thumbs.db
.idea/
yarn-error.log
.vscode/
debug.log
# Vendored native module build artefacts
native/*/build/
native/*/prebuilds/
native/*/package-lock.json
vendor/*/node_modules/
vendor/*/package-lock.json

# Rust build output.
/target/
# The fork under `vendor/webrtc` is its own workspace root, so that CI can run its own test
# suite against the TURN-over-TCP patch. That gives it a second build directory and a second
# lock file, neither of which belongs in the repository -- and the lock in particular would
# make `vendor/webrtc` differ from the crates.io tarball for a reason the patch does not
# explain, which is exactly what the drift check exists to catch.
/vendor/webrtc/target/
/vendor/webrtc/Cargo.lock

# Generated by cargo-about at release time; regenerate rather than commit.
/THIRD-PARTY.html

# The release signing keys. `sign-cert/` is where they are kept on this machine.
#
# The patterns below it are the belt to that brace: a minisign secret key is `release.key`
# wherever it is put, and a key that gets committed is a key that must be replaced -- there
# is no taking it back out of a clone somebody already made. So the name is ignored
# everywhere, not only in the directory it happens to live in today.
sign-cert/
release.key
*.minisign.key
