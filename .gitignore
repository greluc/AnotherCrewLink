.DS_Store
# Anchored: the packaged output lives at the repository root. Without the slash
# this also swallowed the prebuilt dist/ of the vendored modules under native/.
/dist/
/out/
node_modules/
thumbs.db
.idea/
yarn-error.log
.vscode/
debug.log
# Vendored native module build artefacts
native/*/build/
native/*/prebuilds/
native/*/package-lock.json
vendor/*/node_modules/
vendor/*/package-lock.json

# Rust build output.
/target/

# Generated by cargo-about at release time; regenerate rather than commit.
/THIRD-PARTY.html
