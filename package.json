		"minimist": "^1.2.8",
		"node-keyboard-watcher": "file:native/node-keyboard-watcher",
		"path-intersection": "^4.1.0",
		"pretty-bytes": "^7.1.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-i18next": "^17.0.12",
		"registry-js": "^1.16.1",
		"simple-peer": "^9.11.1",
		"socket.io-client": "^4.8.3",
		"source-map-support": "^0.5.21",
		"structron": "file:vendor/structron",
