{
	"name": "anothercrewlink",
	"productName": "AnotherCrewLink",
	"version": "1.0.0",
	"license": "GPL-3.0-or-later",
	"description": "Free, open, Among Us proximity voice chat",
	"repository": {
		"type": "git",
		"url": "https://github.com/greluc/AnotherCrewLink.git"
	},
	"author": {
		"name": "Lucas Greuloch",
		"email": "lucas.greuloch@pm.me",
		"url": "https://aucl.greluc.me"
	},
	"scripts": {
		"postinstall": "electron-builder install-app-deps",
		"lint": "eslint src",
		"dev": "electron-vite dev",
		"compile": "electron-vite build",
		"dist": "npm run compile && electron-builder --win --x64 --ia32",
		"dist:32": "npm run compile && electron-builder --win --ia32",
		"dist:64": "npm run compile && electron-builder --win --x64",
		"dist:linux": "npm run compile && electron-builder --linux --x64",
		"publish": "npm run compile && electron-builder --win --x64 --ia32 --publish always ",
		"publish:linux": "npm run compile && electron-builder --x64 --linux --publish always",
		"audit": "npm audit --audit-level=high",
		"preview": "electron-vite preview",
		"lint:fix": "eslint src --fix"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@fontsource/source-code-pro": "^5.3.0",
		"@fontsource/varela-round": "^5.3.0",
		"@mui/icons-material": "^9.3.1",
		"@mui/material": "^9.3.1",
		"color": "^5.0.3",
		"cross-spawn": "^7.0.6",
		"electron-overlay-window": "file:native/electron-overlay-window",
		"electron-store": "^11.0.2",
		"electron-updater": "^6.8.9",
		"i18next": "^26.4.0",
		"jimp": "^1.6.1",
		"memoryjs": "file:native/memoryjs",
		"minimist": "^1.2.8",
		"node-keyboard-watcher": "file:native/node-keyboard-watcher",
		"path-intersection": "^4.1.0",
		"pretty-bytes": "^7.1.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-i18next": "^17.0.12",
		"registry-js": "^1.16.1",
		"socket.io-client": "^4.8.3",
		"structron": "file:vendor/structron",
		"tss-react": "^4.9.21",
		"webrtc-adapter": "^9.0.6"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/cross-spawn": "^6.0.6",
		"@types/minimist": "^1.2.5",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.1.0",
		"electron": "^43.4.1",
		"electron-builder": "^26.15.3",
		"electron-devtools-installer": "^4.0.0",
		"electron-vite": "^5.0.0",
		"eslint": "^10.9.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-react-hooks": "^7.0.0",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.2"
	},
	"main": "out/main/index.mjs"
}
